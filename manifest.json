{
  "manifest_version": 3,
  "name": "VerifEye: AI Image Detector",
  "version": "2.0.0",
  "description": "Real-time, local-first AI image detection on hover. Powered by open-source frequency, noise, and metadata forensic algorithms.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "action"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {},
  "options_page": "settings/settings.html",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}